# ─────────────────────────────────────────────────────────────
# Contoh env khusus WORKER (mode PC / VPS).
# Simpan sebagai worker/.env  (atau pakai .env.local di root project).
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fyywhatsapp

# ID sesi di koleksi wa_auth (biarkan default kalau hanya satu nomor)
WA_SESSION_ID=default

# Tampilkan QR sebagai teks di terminal supaya bisa langsung dipindai.
# Default: aktif kalau dijalankan di terminal interaktif (mode PC).
WA_TERMINAL_QR=true

# Log: fatal | error | warn | info | debug | trace
WA_LOG_LEVEL=info

# Tarik riwayat chat saat pertama menautkan
WA_SYNC_FULL_HISTORY=true

# Unduh media masuk otomatis ke MongoDB + batas ukurannya
WA_AUTO_MEDIA=true
WA_MAX_MEDIA_MB=8
WA_HISTORY_LIMIT=60
