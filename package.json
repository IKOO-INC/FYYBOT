{
  "name": "fyywhatsappadmin",
  "version": "1.0.0",
  "private": true,
  "description": "FYY WhatsApp Admin \u2014 WhatsApp Web style inbox + Baileys host, session stored in MongoDB",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "worker": "npm --prefix worker run dev",
    "worker:start": "npm --prefix worker start",
    "setup": "npm install --no-audit --no-fund && npm --prefix worker install --no-audit --no-fund",
    "local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "mongodb": "^6.20.0",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  }
}
