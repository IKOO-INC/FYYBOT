# ─────────────────────────────────────────────────────────────
# Panel (Next.js di Vercel)
# ─────────────────────────────────────────────────────────────
# Password untuk masuk ke panel admin. WAJIB diisi.
ADMIN_PASSWORD=ganti-password-ini

# Rahasia untuk menandatangani cookie sesi (bebas, panjang & acak).
# Jika kosong, diturunkan dari ADMIN_PASSWORD.
ADMIN_SECRET=ubah-jadi-string-acak-panjang

# Koneksi MongoDB Atlas — dipakai panel DAN worker.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fyywhatsapp

# ─────────────────────────────────────────────────────────────
# Auto-start worker via GitHub Actions (opsional tapi disarankan)
# ─────────────────────────────────────────────────────────────
# Personal Access Token GitHub dengan izin "Actions: Read and write" pada repo.
# Dipakai panel untuk men-dispatch workflow worker.yml saat heartbeat mati.
GITHUB_TOKEN=
# Default sudah IKOO-INC/FYYBOT + worker.yml + main; ubah bila repo lain.
# GITHUB_REPO=IKOO-INC/FYYBOT
# GITHUB_WORKFLOW=worker.yml
# GITHUB_REF_NAME=main

# Secret untuk cron eksternal: GET /api/cron/worker?key=<CRON_SECRET>
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Worker (Node.js + Baileys) — opsional, default sudah aman
# ─────────────────────────────────────────────────────────────
# ID sesi di koleksi wa_auth (ubah hanya jika satu DB dipakai beberapa nomor)
WA_SESSION_ID=default

# Tarik riwayat chat saat pertama kali menautkan (true/false)
WA_SYNC_FULL_HISTORY=true

# Unduh media otomatis ke MongoDB. Biarkan false agar media hanya diunduh
# saat kamu klik "Ketuk untuk memuat" di panel (hemat kuota & respons cepat).
WA_AUTO_MEDIA=false

# Batas ukuran media yang diunduh ke MongoDB (MB)
WA_MAX_MEDIA_MB=8

# Jumlah pesan histori per chat yang disimpan saat sinkronisasi
WA_HISTORY_LIMIT=120

# Tampilkan QR sebagai teks di terminal (mode PC). Default aktif di terminal.
WA_TERMINAL_QR=true

# Level log worker: fatal | error | warn | info | debug | trace
WA_LOG_LEVEL=warn

# Umur QR (mengikuti default Baileys 6.7: QR pertama 60 dtk, berikutnya 20 dtk).
# Ubah hanya jika kamu juga mengubah qrTimeout di makeWASocket.
WA_QR_TTL_FIRST_MS=60000
WA_QR_TTL_NEXT_MS=20000

# Umur kode pairing (WhatsApp menolak kode lama)
WA_PAIRING_TTL_MS=120000

# Lock mencegah dua worker memegang sesi yang sama (Actions + laptop, dsb.)
WA_LOCK_TTL_MS=90000
WA_LOCK_WAIT_MS=300000
WA_DISABLE_LOCK=false

# Batas umur proses worker (0 = tanpa batas). GitHub Actions memakai 3300000
# (55 menit) agar job berikutnya bisa mengambil alih.
WA_MAX_RUNTIME_MS=0

# ── Keamanan sesi ────────────────────────────────────────────
# Backoff saat gagal connect: 2s, 4s, 8s … maksimal WA_BACKOFF_MAX_MS.
WA_RECONNECT_MAX_ATTEMPTS=8
WA_BACKOFF_MAX_MS=60000
# Setelah menyerah, worker diam menunggu perintah panel atau jeda ini (30 menit).
WA_RETRY_AFTER_GIVEUP_MS=1800000
# Gabungkan penulisan creds (ms) supaya tidak membanjiri MongoDB.
WA_SAVE_CREDS_DEBOUNCE_MS=400
# Batas waktu menunggu semua tulisan auth selesai saat shutdown.
WA_SHUTDOWN_DRAIN_MS=4000
